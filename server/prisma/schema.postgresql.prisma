datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String            @id @default(uuid())
  email               String            @unique
  passwordHash        String
  fullName            String
  role                String            @default("SHAREHOLDER") // SHAREHOLDER, PROXY_REPRESENTATIVE, COMPANY_ADMIN, AUDITOR
  walletAddress       String?           @unique
  isActive            Boolean           @default(true)
  approvalStatus      String            @default("APPROVED") // PENDING, APPROVED, REJECTED
  requestedShares     BigInt?           @default(0)
  rejectionReason     String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  shareholderProfile  Shareholder?
  delegationsGiven    ProxyDelegation[] @relation("Delegator")
  delegationsReceived ProxyDelegation[] @relation("ProxyHolder")
  votesCast           Vote[]
  auditLogs           AuditLog[]
  anomalyAlerts       AnomalyAlert[]

  @@index([email])
  @@index([role])
  @@index([approvalStatus])
}

model Company {
  id             String        @id @default(uuid())
  name           String
  regNumber      String        @unique
  industry       String
  contactEmail   String
  description    String?
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  shareholders   Shareholder[]
  meetings       Meeting[]

  @@index([regNumber])
}

model Shareholder {
  id                 String            @id @default(uuid())
  userId             String            @unique
  companyId          String
  folioNumber        String            @unique
  totalShares        BigInt            @default(0)
  votingPower        BigInt            @default(0)
  delegatedPowerOut  BigInt            @default(0)
  status             String            @default("ACTIVE") // ACTIVE, SUSPENDED
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  company            Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  proxyDelegations   ProxyDelegation[]

  @@index([folioNumber])
  @@index([companyId])
}

model Meeting {
  id             String         @id @default(uuid())
  companyId      String
  title          String
  description    String
  meetingType    String         @default("AGM")
  scheduledDate  DateTime
  startTime      DateTime
  endTime        DateTime
  locationUrl    String?
  status         String         @default("SCHEDULED")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  proposals      Proposal[]

  @@index([companyId])
  @@index([status])
}

model Proposal {
  id                String          @id @default(uuid())
  meetingId         String
  onChainId         BigInt?         @unique
  title             String
  description       String
  category          String
  documentUrl       String?
  startTime         DateTime
  endTime           DateTime
  status            String          @default("DRAFT")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  totalYesVotes     BigInt          @default(0)
  totalNoVotes      BigInt          @default(0)
  totalAbstainVotes BigInt          @default(0)

  meeting           Meeting         @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  votes             Vote[]
  proxyDelegations  ProxyDelegation[]
  aiSummary         AISummary?

  @@index([meetingId])
  @@index([status])
}

model ProxyDelegation {
  id                 String           @id @default(uuid())
  delegatorUserId    String
  proxyUserId        String
  shareholderId      String
  proposalId         String?
  delegatedPower     BigInt
  validFrom          DateTime
  validUntil         DateTime
  status             String           @default("ACTIVE")
  onChainTxHash      String?
  revokedAt          DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  delegator          User             @relation("Delegator", fields: [delegatorUserId], references: [id], onDelete: Restrict)
  proxy              User             @relation("ProxyHolder", fields: [proxyUserId], references: [id], onDelete: Restrict)
  shareholder        Shareholder      @relation(fields: [shareholderId], references: [id], onDelete: Cascade)
  proposal           Proposal?        @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  votes              Vote[]

  @@index([delegatorUserId])
  @@index([proxyUserId])
  @@index([status])
}

model Vote {
  id                 String           @id @default(uuid())
  proposalId         String
  voterUserId        String
  proxyDelegationId  String?
  votingPowerUsed    BigInt
  choice             String           // YES, NO, ABSTAIN
  txHash             String           @unique
  blockNumber        BigInt?
  blockTimestamp     DateTime?
  isVerifiedOnChain  Boolean          @default(false)
  createdAt          DateTime         @default(now())

  proposal           Proposal         @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  voter              User             @relation(fields: [voterUserId], references: [id], onDelete: Restrict)
  proxyDelegation    ProxyDelegation? @relation(fields: [proxyDelegationId], references: [id], onDelete: SetNull)

  @@index([proposalId])
  @@index([voterUserId])
  @@index([txHash])
}

model AISummary {
  id               String          @id @default(uuid())
  proposalId       String          @unique
  executiveSummary String
  keyPoints        String
  importantDates   String
  financialImpact  String?
  legalComplexity  String?
  neutralityScore  Float           @default(1.0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  proposal         Proposal        @relation(fields: [proposalId], references: [id], onDelete: Cascade)
}

model AnomalyAlert {
  id               String          @id @default(uuid())
  userId           String?
  targetEntity     String
  entityId         String?
  reason           String
  severity         String          @default("MEDIUM")
  rawMetadata      String?
  isResolved       Boolean         @default(false)
  createdAt        DateTime        @default(now())

  user             User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([severity])
  @@index([isResolved])
}

model AuditLog {
  id               String          @id @default(uuid())
  userId           String?
  userRole         String?
  action           String
  entity           String
  entityId         String?
  ipAddress        String?
  userAgent        String?
  status           String
  details          String?
  createdAt        DateTime        @default(now())

  user             User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([createdAt])
}
